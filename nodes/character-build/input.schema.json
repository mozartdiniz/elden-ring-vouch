{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "character-build input",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "starting_class": {
      "type": "string",
      "description": "Which class the character started as; one of the ten.",
      "enum": [
        "Astrologer",
        "Bandit",
        "Confessor",
        "Hero",
        "Prisoner",
        "Prophet",
        "Samurai",
        "Vagabond",
        "Warrior",
        "Wretch"
      ]
    },
    "target_level": {
      "type": "integer",
      "minimum": 1,
      "description": "The rune level the user is building toward, e.g. 150. Pass it whenever they name one, so the levels left over are a returned figure rather than a subtraction someone does in their head."
    },
    "vigor": {
      "type": "integer",
      "description": "Omit any stat the user did not name; it becomes the starting class's minimum."
    },
    "mind": {
      "type": "integer"
    },
    "endurance": {
      "type": "integer"
    },
    "strength": {
      "type": "integer"
    },
    "dexterity": {
      "type": "integer"
    },
    "intelligence": {
      "type": "integer"
    },
    "faith": {
      "type": "integer"
    },
    "arcane": {
      "type": "integer"
    }
  }
}