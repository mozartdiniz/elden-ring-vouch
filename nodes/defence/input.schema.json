{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "defence input",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "starting_class": {
      "type": "string",
      "description": "Which class the character started as; one of the ten.",
      "enum": [
        "Astrologer",
        "Bandit",
        "Confessor",
        "Hero",
        "Prisoner",
        "Prophet",
        "Samurai",
        "Vagabond",
        "Warrior",
        "Wretch"
      ]
    },
    "vigor": {
      "type": "integer",
      "description": "Omit any stat the user did not name; it becomes the class minimum."
    },
    "mind": {
      "type": "integer"
    },
    "endurance": {
      "type": "integer"
    },
    "strength": {
      "type": "integer"
    },
    "dexterity": {
      "type": "integer"
    },
    "intelligence": {
      "type": "integer"
    },
    "faith": {
      "type": "integer"
    },
    "arcane": {
      "type": "integer"
    },
    "head": {
      "type": "string",
      "description": "Exact armour name, or omit for a bare slot."
    },
    "chest": {
      "type": "string"
    },
    "arms": {
      "type": "string"
    },
    "legs": {
      "type": "string"
    }
  }
}