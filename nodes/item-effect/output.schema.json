{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "item-effect output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "kinds",
    "effects",
    "combined",
    "quantified",
    "text_only",
    "applied_to_a_build",
    "pvp",
    "assumed",
    "stack_factors",
    "stacked_multiplier",
    "conditional_available"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "talisman, crystal tear, great rune, or other \u2014 one per item, in the same order."
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "text",
          "stats",
          "attack_multiplier",
          "damage_taken",
          "resist",
          "rates",
          "conditional"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "description": "The game's own description. The only account of an item whose effect has no column."
          },
          "stats": {
            "type": "object",
            "additionalProperties": false,
            "description": "Stat bonuses. Negative is possible.",
            "required": [
              "vigor",
              "mind",
              "endurance",
              "strength",
              "dexterity",
              "intelligence",
              "faith",
              "arcane"
            ],
            "properties": {
              "vigor": {
                "type": "integer"
              },
              "mind": {
                "type": "integer"
              },
              "endurance": {
                "type": "integer"
              },
              "strength": {
                "type": "integer"
              },
              "dexterity": {
                "type": "integer"
              },
              "intelligence": {
                "type": "integer"
              },
              "faith": {
                "type": "integer"
              },
              "arcane": {
                "type": "integer"
              }
            }
          },
          "attack_multiplier": {
            "type": "object",
            "additionalProperties": false,
            "description": "Attack multiplier per damage kind, 1.0 for no change. A physical bonus is already expanded across strike, slash and pierce, so this drops into optimal-affinity's damage_multiplier unchanged.",
            "required": [
              "physical",
              "strike",
              "slash",
              "pierce",
              "magic",
              "fire",
              "lightning",
              "holy"
            ],
            "properties": {
              "physical": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "strike": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "slash": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "pierce": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "magic": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "fire": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "lightning": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "holy": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "damage_taken": {
            "type": "object",
            "additionalProperties": false,
            "description": "Multiplier on damage received. Above 1.0 means MORE damage taken, as on Radagon's Soreseal.",
            "required": [
              "physical",
              "strike",
              "slash",
              "pierce",
              "magic",
              "fire",
              "lightning",
              "holy"
            ],
            "properties": {
              "physical": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "strike": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "slash": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "pierce": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "magic": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "fire": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "lightning": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "holy": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "resist": {
            "type": "object",
            "additionalProperties": false,
            "description": "Flat change to a status resistance.",
            "required": [
              "poison",
              "scarlet_rot",
              "bleed",
              "frost",
              "sleep",
              "madness",
              "death"
            ],
            "properties": {
              "poison": {
                "type": "number"
              },
              "scarlet_rot": {
                "type": "number"
              },
              "bleed": {
                "type": "number"
              },
              "frost": {
                "type": "number"
              },
              "sleep": {
                "type": "number"
              },
              "madness": {
                "type": "number"
              },
              "death": {
                "type": "number"
              }
            }
          },
          "rates": {
            "type": "object",
            "additionalProperties": false,
            "description": "Multipliers on max HP, FP, stamina and equip load.",
            "required": [
              "max_hp",
              "max_fp",
              "max_stamina",
              "equip_load"
            ],
            "properties": {
              "max_hp": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "max_fp": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "max_stamina": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "equip_load": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "conditional": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "multiplier",
              "pvp_multiplier",
              "condition",
              "pvp_note",
              "source_text"
            ],
            "properties": {
              "multiplier": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "pvp_multiplier": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "condition": {
                "type": "string",
                "description": "When it applies, quoted from the description. 'with weapon skills' is worth nothing to a normal swing."
              },
              "pvp_note": {
                "type": "string",
                "description": "A PvP caveat the description gives that is not a plain multiplier, e.g. holy not being multiplied."
              },
              "source_text": {
                "type": "string",
                "description": "The sentence the figure was read out of, so a reader can check the parse."
              }
            },
            "description": "The damage multiplier this item's description states, when it states one unambiguously. Null when it does not, or when it quotes several for different targets. Never applied on its own \u2014 see stacked_multiplier."
          }
        }
      }
    },
    "combined": {
      "type": "object",
      "additionalProperties": false,
      "description": "Every item together: stat bonuses summed, multipliers multiplied. Quote these rather than combining the parts yourself.",
      "required": [
        "stats",
        "attack_multiplier",
        "damage_taken",
        "resist",
        "rates"
      ],
      "properties": {
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "description": "Stat bonuses, summed.",
          "required": [
            "vigor",
            "mind",
            "endurance",
            "strength",
            "dexterity",
            "intelligence",
            "faith",
            "arcane"
          ],
          "properties": {
            "vigor": {
              "type": "integer"
            },
            "mind": {
              "type": "integer"
            },
            "endurance": {
              "type": "integer"
            },
            "strength": {
              "type": "integer"
            },
            "dexterity": {
              "type": "integer"
            },
            "intelligence": {
              "type": "integer"
            },
            "faith": {
              "type": "integer"
            },
            "arcane": {
              "type": "integer"
            }
          }
        },
        "attack_multiplier": {
          "type": "object",
          "additionalProperties": false,
          "description": "Attack multipliers, multiplied together.",
          "required": [
            "physical",
            "strike",
            "slash",
            "pierce",
            "magic",
            "fire",
            "lightning",
            "holy"
          ],
          "properties": {
            "physical": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "strike": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "slash": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "pierce": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "magic": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "fire": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "lightning": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "holy": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "damage_taken": {
          "type": "object",
          "additionalProperties": false,
          "description": "Damage-taken multipliers, multiplied together.",
          "required": [
            "physical",
            "strike",
            "slash",
            "pierce",
            "magic",
            "fire",
            "lightning",
            "holy"
          ],
          "properties": {
            "physical": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "strike": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "slash": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "pierce": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "magic": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "fire": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "lightning": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "holy": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "resist": {
          "type": "object",
          "additionalProperties": false,
          "description": "Status resistance changes, summed.",
          "required": [
            "poison",
            "scarlet_rot",
            "bleed",
            "frost",
            "sleep",
            "madness",
            "death"
          ],
          "properties": {
            "poison": {
              "type": "number"
            },
            "scarlet_rot": {
              "type": "number"
            },
            "bleed": {
              "type": "number"
            },
            "frost": {
              "type": "number"
            },
            "sleep": {
              "type": "number"
            },
            "madness": {
              "type": "number"
            },
            "death": {
              "type": "number"
            }
          }
        },
        "rates": {
          "type": "object",
          "additionalProperties": false,
          "description": "Rate multipliers, multiplied together.",
          "required": [
            "max_hp",
            "max_fp",
            "max_stamina",
            "equip_load"
          ],
          "properties": {
            "max_hp": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_fp": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_stamina": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "equip_load": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "quantified": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Items whose effect the tables put a number on."
    },
    "text_only": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Items whose effect exists only as prose. Not items with no effect \u2014 say what the text says."
    },
    "applied_to_a_build": {
      "type": "boolean",
      "description": "Always false. Nothing in this collection applies these automatically; character-build, equip-load and defence all report figures before them."
    },
    "pvp": {
      "type": "boolean"
    },
    "assumed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The items whose conditions the caller asserted. The stack is exactly these."
    },
    "stack_factors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "multiplier",
          "condition",
          "pvp_note"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "multiplier": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "condition": {
            "type": "string"
          },
          "pvp_note": {
            "type": "string"
          }
        }
      },
      "description": "What went into the product, each with the condition it needs. Quote these beside the total: a stack is only as true as its conditions."
    },
    "stacked_multiplier": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "The product of the asserted multipliers. 1.0 when nothing was asserted, which is the honest answer to 'what do these talismans multiply my damage by' when the caller has not said what kind of hit it is."
    },
    "conditional_available": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "multiplier",
          "pvp_multiplier",
          "condition"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "multiplier": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "pvp_multiplier": {
            "type": [
              "number",
              "null"
            ]
          },
          "condition": {
            "type": "string"
          }
        }
      },
      "description": "Multipliers these items state that were NOT counted, because the caller did not assert their conditions. List them in an answer: they are what the player would have to do to get them."
    }
  }
}
