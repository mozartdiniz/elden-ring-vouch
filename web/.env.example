# Local development: uses the Claude CLI session already on this machine.
LLM_BACKEND=claude

# Deployed: uncomment these and set a spend limit on the key itself.
# LLM_BACKEND=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-5
# APP_URL=https://example.com
# APP_NAME=Elden Ring, computed

# COLLECTION=/srv/elden-ring-vouch
# VOUCH_BIN=/usr/local/bin/vouch
DAILY_BUDGET=200
RATE_PER_MIN=6
