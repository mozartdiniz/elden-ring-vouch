# Local development: uses the Claude CLI session already on this machine.
LLM_BACKEND=claude

# Deployed: uncomment these and set a spend limit on the key itself.
# LLM_BACKEND=openrouter
# OPENROUTER_API_KEY=sk-or-...
# Measured on battery question 1.1, all four models in openrouter_models.txt answered and
# attested. Cost per question differs by 8x: luna $0.040, kimi $0.143, sol $0.315, grok
# $0.325. See scripts/compare_models.py and the table in PLAN-web-app.md.
# OPENROUTER_MODEL=openai/gpt-5.6-luna
# APP_URL=https://example.com
# APP_NAME=Elden Ring, computed

# COLLECTION=/srv/elden-ring-vouch
# VOUCH_BIN=/usr/local/bin/vouch
DAILY_BUDGET=200
RATE_PER_MIN=6
